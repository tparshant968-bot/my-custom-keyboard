<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.clipboardkeyboard">

    <application
        android:allowBackup="true"
        android:label="Ramayan Clipboard"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.MyCustomClipboard">

        <!-- App Screen (UI Manager) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.EditItemActivity"
            android:exported="false" />

        <!-- Keyboard Service (WhatsApp Typing Input) -->
        <service
            android:name=".CustomKeyboardService"
            android:label="Ramayan Clipboard Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>
</manifest>
